# Run make local-db-init to generate an ignored .env with a random token.
# When configuring an existing server, use its existing token instead.
DB_TOKEN=replace_with_64_hex_characters
DB_PORT=9494
DB_DATA_DIR=./data
# Defaults to quack:127.0.0.1:DB_PORT when omitted from Make.
# DB_URL=quack:127.0.0.1:9494
# Local Compose intentionally serves plain HTTP on loopback.
DB_DISABLE_SSL=true

# Required only for indexing: existing directories separated by semicolons.
DOCS=
CHAT_MODEL=mistralai/Ministral-3-8B-Instruct-2512-GGUF:Q4_K_M
EMBEDDING_MODEL=bartowski/granite-embedding-278m-multilingual-GGUF:Q8_0
DIMENSIONS=768

CHAT_PORT=18080
OPEN_BROWSER=true
CHAT_HOST=127.0.0.1
CHAT_ALLOW_ANY_HOST=true
CHAT_PUBLIC_URL=

FORCE_INDEX=false
DOCUMENT_WORKERS=20
EMBEDDING_WORKERS=1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BUFFER_BATCHES=16
INSERT_BATCH_SIZE=128
